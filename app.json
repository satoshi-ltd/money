{
  "expo": {
    "name": "Môney",
    "slug": "satoshi-ltd-money",
    "owner": "satoshi-ltd",
    "scheme": "money",
    "description": "Your private finance ledger running on your own blockchain",
    "version": "3.0.49",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.satoshi-limited.money",
      "buildNumber": "28",
      "usesIcloudStorage": true,
      "infoPlist": {
        "LSMinimumSystemVersion": "15.1",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15140F"
      },
      "package": "com.satoshilimited.money",
      "versionCode": 28,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1242,
          "resizeMode": "contain",
          "backgroundColor": "#F2EFE8"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFFEFE"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b660421b-8423-40bd-b924-11109faac99c"
      }
    }
  }
}
