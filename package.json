{
  "name": "money",
  "version": "3.0.46",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint --cache --format stylish --ext .jsx,.js src",
    "lint:fix": "eslint --cache --fix --format stylish --ext .jsx,.js src",
    "test": "jest",
    "eas:login": "npx eas-cli login",
    "eas:whoami": "npx eas-cli whoami",
    "build:dev": "npx eas-cli build --platform android --profile development",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:prod": "npx eas-cli build --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "crypto": "^1.0.1",
    "events": "^3.3.0",
    "expo": "~55.0.28",
    "expo-blur": "~55.0.16",
    "expo-dev-client": "~55.0.37",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-linear-gradient": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "jest": "^29.2.1",
    "jest-expo": "~55.0.20",
    "prop-types": "^15.8.1",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-regenerator": "^7.20.5",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "4.6.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleNameMapper": {
      "^expo-modules-core/src/Refs$": "<rootDir>/src/test/mocks/expo-modules-core-Refs.js",
      "^expo-modules-core/src/web/index\\.web$": "<rootDir>/src/test/mocks/expo-modules-core-web-index.js",
      "^expo/src/async-require/messageSocket$": "<rootDir>/src/test/mocks/expo-async-require-messageSocket.js",
      "^expo/src/winter/FormData$": "<rootDir>/src/test/mocks/expo-winter-FormData.js",
      "^expo/src/winter$": "<rootDir>/src/test/mocks/expo-winter-index.js"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    }
  }
}
