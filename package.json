{
  "name": "money",
  "version": "3.0.104",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client --scheme money",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint --cache --format stylish --ext .jsx,.js src",
    "lint:fix": "eslint --cache --fix --format stylish --ext .jsx,.js src",
    "test": "jest",
    "rates:seed": "node scripts/rates-seed.mjs",
    "check:release": "node scripts/check-release.mjs",
    "bump": "node scripts/bump.mjs",
    "validate": "yarn check:release && yarn lint && yarn test",
    "design": "node design/build.mjs",
    "site:build": "node site/scripts/build.mjs",
    "site:release": "node site/scripts/read-release.mjs",
    "eas:login": "npx eas-cli login",
    "eas:whoami": "npx eas-cli whoami",
    "build:dev": "node scripts/android-build.mjs dev",
    "build:prod": "node scripts/android-build.mjs prod",
    "build:local:dev": "node scripts/android-build.mjs dev --local",
    "build:local:prod": "node scripts/android-build.mjs prod --local"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "crypto": "^1.0.1",
    "events": "^3.3.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prop-types": "^15.8.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-regenerator": "^7.20.5",
    "@react-native/jest-preset": "0.88.1",
    "eslint": "8.57.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "4.6.2",
    "react-test-renderer": "19.3.0"
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/scripts/jest-timezone.cjs",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    }
  }
}
